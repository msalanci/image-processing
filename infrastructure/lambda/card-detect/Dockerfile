# CPU container image for the card-detect lambda (ONNX ViT-B/32 P(card)).
# Build for arm64 (Graviton), same as the image-processor lambda.
#
# Build (on the M4 mac, native arm64):
#   docker build --platform linux/arm64 -t buildercards-card-detect.
#
# The model artifacts (visual.onnx + visual.onnx.data + text.npz) are generated by build_onnx.py in this directiry,
# into onnx_out/ and baked into the image under MODEL_DIR=/opt/model, so cold starts load a local file and download nothing.

FROM public.ecr.aws/lambda/python:3.14

# onnxruntime needs libgomp
RUN dnf install -y libgomp && dnf clean all

# Runtime Python deps (torch-free): onnxruntime + numpy + pillow
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the proven ONNX artifacts into the image.
# /opt is read-only at runtime, but writable at build; MODEL_DIR (index.py) points here. 
ENV MODEL_DIR=/opt/model
COPY onnx_out/ /opt/model/
RUN chmod -R a+rX /opt/model

COPY index.py ${LAMBDA_TASK_ROOT}/

# Lambda handler entrypoint: <module>.<function>
CMD ["index.handler"]
